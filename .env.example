# ==============================================================================
# Retail Brain OS — Node.js Backend Environment Variables
# Copy to `.env` for local development or inject via Cloud Run Secrets / Env.
# Never commit `.env` with real credentials to Git.
# The Python edge service has its own separate template in `vision-service/.env.example`.
# ==============================================================================

# Runtime environment ("development" or "production").
# Setting NODE_ENV="production" disables demo authentication across backend & UI.
NODE_ENV="development"

# HTTP & WebSocket server port (must be 3000 in AI Studio preview / Cloud Run).
PORT="3000"

# Public deployed backend/app URL (injected by Cloud Run or set manually).
APP_URL="MY_APP_URL"

# Firebase project ID for verifying Firebase Authentication ID tokens.
FIREBASE_PROJECT_ID="elite-ray-sflln"

# Shared secret authenticating outbound detection events from Python vision-service
# (`POST /api/vision/events`) and outbound calls to `VISION_SERVICE_URL`.
# Required in production; backend rejects /api/vision/events whenever unset or invalid.
EDGE_API_KEY="CHANGE_ME_EDGE_API_KEY"

# Server-side AES-256-GCM encryption key for RTSP camera URLs/credentials.
# Required when registering/updating/decrypting RTSP cameras.
# IMPORTANT: Never rotate this value with existing stored RTSP secrets without
# first running `npm run migrate:camera-keys`.
CAMERA_SECRET_KEY="CHANGE_ME_32_BYTE_SECRET_KEY"

# Optional reachable URL of the Python YOLOv8n + ByteTrack vision service.
# Leave blank when running without a live Python edge container; UI will clearly
# indicate Demo Simulation mode instead of fabricated YOLO inference.
# In cloud deployments, localhost is NOT reachable from Cloud Run.
VISION_SERVICE_URL=""

# Optional Gemini API key (configured via Secrets panel if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
