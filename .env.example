# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VISION_SERVICE_URL: Optional URL for the standalone Python YOLOv8n + ByteTrack edge service.
VISION_SERVICE_URL="http://127.0.0.1:8001"

# EDGE_API_KEY: Shared key authenticating outbound detection events from vision-service to Node backend.
EDGE_API_KEY="CHANGE_ME_EDGE_API_KEY"

# CAMERA_SECRET_KEY: Server-side AES-256-GCM encryption key for RTSP camera URLs/credentials.
CAMERA_SECRET_KEY="CHANGE_ME_32_BYTE_SECRET_KEY"
