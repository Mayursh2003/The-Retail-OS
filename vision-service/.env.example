# ==============================================================================
# Retail Brain OS — Python Edge Vision Service Environment Variables
# Copy to `vision-service/.env` on the edge machine / Docker host.
# Never commit `vision-service/.env` with real secrets to Git.
# This file is completely separate from the Node.js backend `.env`.
# ==============================================================================

# URL of the Node.js Retail Brain OS backend receiving outbound detection events.
# Local dev: "http://127.0.0.1:3000" (or "http://host.docker.internal:3000" in Docker)
# Cloud deployment: "https://<your-deployed-nodejs-backend-url>"
BACKEND_URL="http://127.0.0.1:3000"

# Must match the EDGE_API_KEY configured on the Node.js backend.
EDGE_API_KEY="CHANGE_ME_EDGE_API_KEY"

# YOLOv8 model weights and person-detection confidence threshold.
YOLO_MODEL="yolov8n.pt"
YOLO_CONF="0.45"

# Outbound event throttle per temporary track ID (seconds) and annotated video TTL (seconds).
EVENT_THROTTLE_SECONDS="2.5"
ANNOTATION_TTL_SECONDS="1800"
