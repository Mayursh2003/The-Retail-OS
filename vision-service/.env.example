# Standalone Python Vision Edge Service Environment Configuration
# Copy to vision-service/.env and populate with deployment values (never commit .env files).

# BACKEND_URL: Deployed Node.js Retail Brain OS backend base URL (e.g. https://your-cloud-run-service.run.app)
BACKEND_URL=

# EDGE_API_KEY: Must match EDGE_API_KEY configured on the Node.js backend
EDGE_API_KEY=

# YOLOv8 Inference Defaults
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45
